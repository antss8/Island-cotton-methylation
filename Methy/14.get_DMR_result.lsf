rm /public/home/zhfan/WPH/Gbar3-79/3.DMR/PerTXT/Fisher_exact_test/P-Result/CHG/ReallyDMR/FDR/sorted_${i}_CHG_FDRper.txt

sort -t $'\t' -k 1,1 -k 2,2n /public/home/zhfan/WPH/Gbar3-79/3.DMR/PerTXT/Fisher_exact_test/P-Result/CHG/ReallyDMR/FDR/${i}_CHG_FDR_result.txt > /public/home/zhfan/WPH/Gbar3-79/3.DMR/PerTXT/Fisher_exact_test/P-Result/CHG/ReallyDMR/FDR/sorted_last/${i}_CHGFDR_sorted.txt

cut -f1-3 -d$'\t' /public/home/zhfan/WPH/Gbar3-79/3.DMR/PerTXT/Fisher_exact_test/P-Result/CHG/ReallyDMR/FDR/sorted_last/${i}_CHGFDR_sorted.txt > /public/home/zhfan/WPH/Gbar3-79/3.DMR/PerTXT/Fisher_exact_test/P-Result/CHG/ReallyDMR/FDR/sorted_last/bed3/${i}_CHGFDR_sorted.bed3
done

